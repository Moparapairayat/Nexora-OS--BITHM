# Core services
PORT="8311"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8311/api"
WEB_ORIGIN="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
ML_NLP_URL="http://localhost:8010"

# Neon PostgreSQL (see docs/NEON_DATABASE_MIGRATION.md). apps/web/.env must
# point at this SAME database — it runs its own Prisma queries directly.
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].[REGION].aws.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET="replace-with-a-long-random-secret"
AI_MODE="local"
UPLOAD_DIR="./storage/uploads"
STORAGE_MODE="local"
MAX_UPLOAD_MB="25"
AUDIT_LOG_MODE="database"
SESSION_COOKIE_NAME="nexora_session"
OPS_ADMIN_EMAIL="admin@nexora.local"
NEXORA_DATA_MODE="database"
DATA_EXPORT_MODE="database-json"
DATA_SYNC_STRATEGY="prisma"
NEXORA_BOOTSTRAP_ADMIN_EMAIL=""
NEXORA_BOOTSTRAP_ADMIN_PASSWORD=""
NEXORA_BOOTSTRAP_ADMIN_NAME="Nexora Administrator"
# Seeds admin@nexora.local / password123 (and other demo accounts). Defaults to
# ON outside production. In production (NODE_ENV=production) this must be set
# to the literal string "true" to opt in — it defaults to OFF there.
NEXORA_DEMO_LOGIN_ENABLED="true"
CODE_RUN_TIMEOUT_MS="4000"
CODE_RUN_DOCKER_PULL_POLICY="never"
CODE_RUN_PYTHON_IMAGE="python:3.12-alpine"
CODE_RUN_NODE_IMAGE="node:22-alpine"
CODE_RUN_MEMORY_LIMIT="256m"
CODE_RUN_CPU_LIMIT="0.5"
CODE_RUN_PIDS_LIMIT="128"
